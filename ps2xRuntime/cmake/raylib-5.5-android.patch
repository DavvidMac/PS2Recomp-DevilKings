 // Register all input events
 void PollInputEvents(void)
 {
+    // ps2x: follow the window when the device rotates. The activity handles orientation
+    // changes itself (configChanges), so the surface stays but its size changes. The buffers
+    // go back to the window's own size (InitGraphicsDevice() fixed them to the first one), and
+    // the screen, the viewport and the projection follow it.
+    CORE.Window.resizedLastFrame = false;
+    if ((platform.app != NULL) && (platform.app->window != NULL) && isGpuReady && !platform.contextRebindRequired)
+    {
+        static ANativeWindow *ps2xFreedWindow = NULL;
+        if (ps2xFreedWindow != platform.app->window)
+        {
+            ANativeWindow_setBuffersGeometry(platform.app->window, 0, 0, 0);
+            ps2xFreedWindow = platform.app->window;
+        }
+        const int width = ANativeWindow_getWidth(platform.app->window);
+        const int height = ANativeWindow_getHeight(platform.app->window);
+        if ((width > 0) && (height > 0) && ((width != CORE.Window.screen.width) || (height != CORE.Window.screen.height)))
+        {
+            CORE.Window.display.width = width;
+            CORE.Window.display.height = height;
+            CORE.Window.screen.width = width;
+            CORE.Window.screen.height = height;
+            CORE.Window.render.width = width;
+            CORE.Window.render.height = height;
+            CORE.Window.currentFbo.width = width;
+            CORE.Window.currentFbo.height = height;
+            CORE.Window.renderOffset.x = 0;
+            CORE.Window.renderOffset.y = 0;
+            CORE.Window.screenScale = MatrixIdentity();
+            SetupViewport(width, height);
+            CORE.Window.resizedLastFrame = true;
+        }
+    }
+
